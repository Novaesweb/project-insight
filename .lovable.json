{
  "projectName": "Novaes Web",
  "projectDescription": "Painel Administrativo completo para gestão de clientes, projetos, financeiro e muito mais",
  "framework": "react",
  "language": "typescript",
  "cssFramework": "tailwind",
  "componentLibrary": "shadcn-ui",
  "ui": {
    "theme": "dark",
    "themeColor": "#6366f1"
  },
  "features": {
    "pwa": true,
    "supabase": true,
    "authentication": true,
    "realtime": true,
    "pushNotifications": true
  },
  "buildConfig": {
    "buildCommand": "vite build",
    "devCommand": "vite",
    "previewCommand": "vite preview",
    "installCommand": "npm install"
  },
  "directories": {
    "components": "src/components",
    "pages": "src/pages",
    "hooks": "src/hooks",
    "lib": "src/lib",
    "styles": "src"
  },
  "gitConnection": true,
  "autoCommit": true,
  "deploymentReady": true
}
